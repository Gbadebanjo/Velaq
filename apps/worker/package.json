{
  "name": "@velaq/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && concurrently -k -n tsc,worker \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@velaq/contracts": "workspace:*",
    "@velaq/db": "workspace:*"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.12",
    "@types/node": "^22.9.0",
    "concurrently": "^9.2.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
