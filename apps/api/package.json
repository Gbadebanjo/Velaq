{
  "name": "@velaq/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsc -p tsconfig.json && concurrently -k -n tsc,api \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.7",
    "@nestjs/core": "^10.4.7",
    "@nestjs/platform-express": "^10.4.7",
    "@velaq/contracts": "workspace:*",
    "@velaq/db": "workspace:*",
    "pdfkit": "0.17.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.7",
    "@types/node": "^22.9.0",
    "@types/pdfkit": "0.17.3",
    "@types/supertest": "^7.2.1",
    "concurrently": "^9.2.1",
    "supertest": "^7.3.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
