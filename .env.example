# Copy to .env for local development. Never commit real values.
# Which product database this API and worker serve: business, personal or marketplace.
PLANE=personal
# The apps connect as velaq_app (row level security applies). One URL per product database.
DATABASE_URL_BUSINESS=postgres://velaq_app:velaq_app@localhost:5432/velaq_business
DATABASE_URL_PERSONAL=postgres://velaq_app:velaq_app@localhost:5432/velaq_personal
# Migrations only, with the admin role. Leave one unset to skip that database.
DATABASE_ADMIN_URL_BUSINESS=postgres://postgres:postgres@localhost:5432/velaq_business
DATABASE_ADMIN_URL_PERSONAL=postgres://postgres:postgres@localhost:5432/velaq_personal
DATABASE_ADMIN_URL_MARKETPLACE=postgres://postgres:postgres@localhost:5432/velaq_marketplace
# Sign-in database. Leave both unset to use the built-in local database (apps/api/.data), no Docker needed.
# DATABASE_URL_IDENTITY=postgres://velaq_app:velaq_app@localhost:5432/velaq_identity
# DATABASE_ADMIN_URL_IDENTITY=postgres://postgres:postgres@localhost:5432/velaq_identity
# Tenants or spaces the worker relays events for (comma separated), until a registry drives this.
RELAY_SCOPES=
REDIS_URL=redis://localhost:6379
API_PORT=4000
# Offline lease for cached device data, in hours. Tenants may shorten it, never extend it.
OFFLINE_LEASE_HOURS=24
# Sign-in. Locally, emails (with their codes) are printed in the API terminal instead of sent.
# AUTH_SECRET hashes email codes; required in production, optional locally.
AUTH_SECRET=
# Production email sending through Resend.
RESEND_API_KEY=
EMAIL_FROM=Velaq <no-reply@velaq.com>
# Shared with the website so the API rate-limits per visitor. Not needed locally.
WEB_API_KEY=
# Set to off to skip the leaked-password check (it calls api.pwnedpasswords.com).
PASSWORD_BREACH_CHECK=on
# AI ("Tailor for a job"). Get a key at console.anthropic.com. Leave empty to keep AI off.
ANTHROPIC_API_KEY=
# claude-haiku-5-5 is fast and low cost; claude-sonnet-5-5 writes more richly at a higher price.
AI_MODEL=claude-haiku-5-5
# How many tailorings one person may run per day.
AI_DAILY_LIMIT=20
